{
  "name": "masm-runner",
  "displayName": "MASM Runner",
  "description": "Extension for compiling and running MASM (Microsoft Macro Assembly Language)",
  "icon": "images/icon.png",
  "version": "1.0.0",
  "publisher": "istareatscreens",
  "homepage": "https://github.com/istareatscreens/vscode-masm-runner",
  "private": false,
  "license": "MIT",
  "keywords": [
    "masm",
    "assembly",
    "compiler",
    "asm",
    "microsoft macro assembly language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/istareatscreens/vscode-masm-runner"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "markdown": "github",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:masmRunner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "masmRunner.start",
        "title": "Start MASM runner CMD",
        "category": "Masm Runner",
        "icon": "$(browser)"
      },
      {
        "command": "masmRunner.runCode",
        "title": "Compile and run MASM code",
        "category": "Masm Runner",
        "icon": "$(play)"
      },
      {
        "command": "masmRunner.resetCMD",
        "title": "Restart MASM Command Prompt",
        "category": "Masm Runner",
        "icon": "$(debug-restart)"
      },
      {
        "command": "masmRunner.sendToMasmWebview",
        "title": "Send file(s) to MASM Runner Webview",
        "category": "Masm Runner"
      },
      {
        "command": "masmRunner.resetCMDCache",
        "title": "Factory reset MASM Command Prompt (keep or delete stored files)",
        "category": "Masm Runner"
      }
    ],
    "keybindings": [
      {
        "command": "masmRunner.runCode",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "resourceExtname =~ /^[.]asm$/i"
      },
      {
        "command": "masmRunner.start",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "snippets": [
      {
        "language": "MASM",
        "path": "./snippets.json"
      },
      {
        "language": "masm-plain",
        "path": "./snippets.json"
      }
    ],
    "languages": [
      {
        "id": "MASM",
        "aliases": [
          "MASM",
          "masm",
          "Microsft Macro Assembly"
        ],
        "extensions": [
          ".asm",
          ".ASM",
          ".inc",
          ".INC",
          ".mac",
          ".MAC"
        ],
        "configuration": "./syntax/language-configuration.json"
      },
      {
        "id": "masm-plain",
        "aliases": [
          "MASM (No Highlighting)"
        ],
        "configuration": "./syntax/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "MASM",
        "scopeName": "source.asm.masm",
        "path": "./syntax/masm.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "masmProcedure",
        "superType": "function",
        "description": "A MASM procedure name: PROC, ENDP, PROTO or EXTERN ...:PROC, or a reference to one"
      },
      {
        "id": "masmMacro",
        "superType": "macro",
        "description": "A MASM macro name: MACRO, or a macro call"
      },
      {
        "id": "masmLabel",
        "superType": "label",
        "description": "A MASM code or macro label, or a jump or GOTO target"
      },
      {
        "id": "masmVariable",
        "superType": "variable",
        "description": "A MASM data name, structure or record field, equate or text macro, or a reference to one"
      },
      {
        "id": "masmParameter",
        "superType": "parameter",
        "description": "A MASM procedure, prototype, macro or FOR/FORC parameter, or a reference to one"
      },
      {
        "id": "masmLocal",
        "superType": "variable",
        "description": "A MASM LOCAL name in a procedure or macro, or a reference to one"
      },
      {
        "id": "masmType",
        "superType": "type",
        "description": "A MASM STRUCT, UNION, RECORD, SEGMENT, GROUP or TYPEDEF name, or a reference to one"
      },
      {
        "id": "masmTextLiteral",
        "superType": "string",
        "description": "A MASM <text> literal"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "MASM",
        "scopes": {
          "masmProcedure": [
            "entity.name.function.masm"
          ],
          "masmMacro": [
            "entity.name.function.macro.masm"
          ],
          "masmLabel": [
            "entity.name.label.masm"
          ],
          "masmVariable": [
            "variable.other.masm"
          ],
          "masmParameter": [
            "variable.other.masm"
          ],
          "masmLocal": [
            "variable.other.masm"
          ],
          "masmType": [
            "storage.type.masm"
          ],
          "masmTextLiteral": [
            "string.quoted.angle.masm"
          ]
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "MASM Runner",
      "properties": {
        "masmRunner.exportBinaries": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Export the `.exe` and `.obj` of each webview (cmd) build into `bin\\` beside the source."
        },
        "masmRunner.autoSyncProjectFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep the terminal's D: drive in sync with the workspace while the terminal is open. MASM sources (`.asm`) and the file types in `#masmRunner.autoSyncFileTypes#` are placed on D: when the terminal starts and whenever they are created or changed. Files you compile, send or `INCLUDE` are kept in sync too: a change saved in VS Code, or made on disk, is copied to D:, and files changed while the terminal was closed are refreshed when it starts."
        },
        "masmRunner.autoSyncFileTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[^\\\\/:*?\"<>|.\\s]+$",
            "patternErrorMessage": "A file extension with its dot, for example .inc"
          },
          "uniqueItems": true,
          "default": [
            ".inc",
            ".mac"
          ],
          "markdownDescription": "The file types placed on the terminal's D: drive automatically besides MASM sources (`.asm`, always included), while `#masmRunner.autoSyncProjectFiles#` is on. By default the include and macro files `.inc` and `.mac`. Remove a type to stop syncing it automatically; any file can still be sent with **Send file(s) to MASM Runner Webview**. Files in `bin` folders, hidden folders and `node_modules`, and copies of the bundled Irvine include files, are never synced automatically."
        },
        "masmRunner.enableContextMenus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enables context menu in Explorer (used to send files to boxedwine webview (cmd))"
        },
        "masmRunner.addCustomCompilerArgumentsAtStart": {
          "type": "string",
          "default": "",
          "markdownDescription": "Adds custom JWASM compiler arguments at start of command (native only)"
        },
        "masmRunner.addCustomCompilerArgumentsAtEnd": {
          "type": "string",
          "default": "",
          "markdownDescription": "Adds custom JWASM compiler arguments at end of command (native only)"
        },
        "masmRunner.addCustomLinkArgumentsAtStart": {
          "type": "string",
          "default": "",
          "markdownDescription": "Adds custom JWLINK compiler arguments at start of command (native only)"
        },
        "masmRunner.addCustomLinkArgumentsLibrary": {
          "type": "string",
          "default": "",
          "markdownDescription": "Adds custom JWLINK compiler arguments after library arguments (native only)"
        },
        "masmRunner.addCustomLinkArgumentsAtEnd": {
          "type": "string",
          "default": "",
          "markdownDescription": "Adds custom JWLINK compiler arguments at end of command (native only)"
        },
        "masmRunner.enableSyntaxHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable or disable syntax highlighting for MASM files: sources (`.asm`), include files (`.inc`) and macro files (`.mac`), in any letter case. When disabled, files will appear as plain text."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "when": "config.masmRunner.enableContextMenus",
          "command": "masmRunner.sendToMasmWebview",
          "group": "4_masmRunner"
        },
        {
          "when": "resourceExtname =~ /^[.]asm$/i",
          "command": "masmRunner.runCode",
          "group": "4_masmRunner"
        }
      ],
      "editor/title": [
        {
          "command": "masmRunner.runCode",
          "when": "resourceExtname =~ /^[.]asm$/i",
          "group": "navigation@1"
        },
        {
          "command": "masmRunner.start",
          "when": "resourceExtname =~ /^[.]asm$/i",
          "group": "navigation@2"
        },
        {
          "command": "masmRunner.resetCMD",
          "when": "resourceExtname =~ /^[.]asm$/i || resourceExtname == .exe || masmRunner.webviewActive",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint .",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^18.19.130",
    "@types/vscode": "~1.82.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "ovsx": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "isbinaryfile": "^5.0.7"
  }
}
