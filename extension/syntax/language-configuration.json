{
  "comments": {
    "lineComment": ";",
    "blockComment": ["COMMENT ~", "~"]
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["<", ">"],
    ["'", "'"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": {
        "pattern": "^\\s*(?:[\\w@$?]+\\s+)?(?:PROC|MACRO|STRUCT|STRUC|UNION|SEGMENT)\\b|^\\s*\\.(?:IF|WHILE|REPEAT)\\b|^\\s*(?:IF(?:E|B|NB|DEF|NDEF|DIF|DIFI|IDN|IDNI|1|2)?|REPEAT|REPT|WHILE|FOR|FORC|IRP|IRPC)\\b",
        "flags": "i"
      },
      "end": {
        "pattern": "^\\s*(?:[\\w@$?]+\\s+)?(?:ENDP|ENDS)\\b|^\\s*(?:ENDM|ENDIF)\\b|^\\s*\\.(?:ENDIF|ENDW|UNTIL|UNTILCXZ)\\b",
        "flags": "i"
      }
    }
  },
  "wordPattern": "([a-zA-Z_@?$][a-zA-Z0-9_@?$]*)",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:[\\w@$?]+\\s+)?(?:PROC|MACRO|STRUCT|STRUC|UNION|SEGMENT)\\b|^\\s*\\.(?:IF|ELSEIF|ELSE|WHILE|REPEAT)\\b|^\\s*(?:IF(?:E|B|NB|DEF|NDEF|DIF|DIFI|IDN|IDNI|1|2)?|ELSE|ELSEIF(?:E|B|NB|DEF|NDEF|DIF|DIFI|IDN|IDNI|1|2)?|REPEAT|REPT|WHILE|FOR|FORC|IRP|IRPC)\\b",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:[\\w@$?]+\\s+)?(?:ENDP|ENDS)\\b|^\\s*(?:ENDM|ENDIF|ELSE|ELSEIF(?:E|B|NB|DEF|NDEF|DIF|DIFI|IDN|IDNI|1|2)?)\\b|^\\s*\\.(?:ENDIF|ENDW|UNTIL|UNTILCXZ|ELSE|ELSEIF)\\b",
      "flags": "i"
    }
  }
}
