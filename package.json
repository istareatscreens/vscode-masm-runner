{
  "name": "vscode-masm-runner",
  "version": "1.0.0",
  "description": "VSCode extension for compiling and running MASM (Microsoft Macro Assembly Language)",
  "scripts": {
    "watch": "gulp build && gulp watch",
    "build": "gulp build",
    "package": "gulp build && cd ./extension && npm run vscode:prepublish && npm run package",
    "test": "node --test \"scripts/**/*.test.cjs\"",
    "sync:grammar": "node scripts/sync-grammar.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/istareatscreens/vscode-masm-runner"
  },
  "keywords": [
    "MASM",
    "vscode",
    "compiler",
    "linker"
  ],
  "author": "istareatscreens",
  "homepage": "https://github.com/istareatscreens/vscode-masm-runner",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "del": "^9.0.1",
    "fake-indexeddb": "6.2.7",
    "file-loader": "^6.2.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "webpack": "^5.112.2",
    "webpack-merge": "^6.0.1",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "any-ascii": "^0.3.3",
    "eol": "^0.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "graceful-fs": "^4.2.9"
  }
}
